# Copy this file to .env.local and fill in the values. .env.local is git-ignored: never commit it.
GEMINI_API_KEY=
# Optional
# KISAN_CHAT_MODEL=gemini-3.5-flash
# KISAN_CHAT_FALLBACK_MODELS=gemini-flash-latest,gemini-flash-lite-latest
# Google sign-in: the Client ID of a Google Cloud OAuth client (type "Web application").
# It is public (it goes into the page). The /api/auth-google function reads the same variable.
# VITE_GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
